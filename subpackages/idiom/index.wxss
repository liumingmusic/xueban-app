.wrap { padding-top: 24rpx; }
.badge-line { margin-bottom: 12rpx; }
.today-badge {
  font-size: 22rpx; color: var(--c-idiom);
  border: 1rpx solid var(--c-idiom);
  border-radius: 999rpx; padding: 4rpx 20rpx;
}
.word { font-size: 64rpx; font-weight: 700; letter-spacing: 12rpx; text-align: center; }
.pinyin { font-size: 28rpx; color: var(--c-idiom); text-align: center; margin: 8rpx 0 20rpx; }
.tags.center { text-align: center; }

.ops { display: flex; gap: 16rpx; justify-content: center; margin-top: 20rpx; }
.ops .btn { margin: 0; }

.sec-title {
  font-size: 26rpx; color: var(--c-idiom); font-weight: 600;
  letter-spacing: 4rpx; margin-bottom: 12rpx;
}
.sec-text { font-size: 30rpx; line-height: 1.9; }
.story { text-indent: 2em; }
.source { font-size: 24rpx; color: var(--ink-2); margin-top: 16rpx; }

.rel-line { margin: 8rpx 0; }
.rel-key {
  font-size: 24rpx; color: var(--ink-2); margin-right: 16rpx;
}

.bottom-ops { display: flex; gap: 20rpx; justify-content: center; margin: 12rpx 24rpx; }
.foot-space { height: 60rpx; }

/* 我的学习 */
.my-track { height: 22rpx; background: var(--bg); border-radius: 12rpx; overflow: hidden; }
.my-fill { height: 100%; background: var(--c-idiom); border-radius: 12rpx; }
.my-text { font-size: 24rpx; color: var(--ink-2); margin-top: 12rpx; }
.row.flat { border: none; background: transparent; border-bottom: 1rpx solid var(--line); border-radius: 0; margin-bottom: 0; padding: 18rpx 4rpx; }
.row.flat:last-child { border-bottom: none; }
