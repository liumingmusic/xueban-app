.wrap { padding-top: 60rpx; }
.main-card { padding: 48rpx; }
.badge-line { margin-bottom: 20rpx; display: flex; gap: 12rpx; }
.today-badge {
  font-size: 22rpx; color: var(--c-quote);
  border: 1rpx solid var(--c-quote);
  border-radius: 999rpx; padding: 4rpx 20rpx;
}
.offline-badge {
  font-size: 22rpx; color: var(--ink-2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx; padding: 4rpx 20rpx;
}
.mark { font-size: 72rpx; color: var(--c-quote); line-height: 1; opacity: 0.5; }
.mark.end { text-align: right; }
.text { font-size: 40rpx; line-height: 2; padding: 0 16rpx; }
.from { text-align: right; font-size: 26rpx; color: var(--ink-2); margin-top: 16rpx; }
.type-chip {
  display: inline-block;
  font-size: 22rpx; color: var(--c-quote);
  background: #eef4f9; border-radius: 8rpx;
  padding: 4rpx 16rpx; margin-top: 16rpx;
}
.ops { display: flex; flex-wrap: nowrap; gap: 12rpx; justify-content: center; margin-top: 36rpx; }
.ops .btn { margin: 0; background: var(--c-quote); flex: 0 0 auto; }
.ops .btn.ghost { background: transparent; color: var(--c-quote); border-color: var(--c-quote); }
