/* 复习页 */
.ph-review .ph-wm { background: var(--c-quiz); }

.list { padding: 0 var(--gap); }

.rv-item {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  padding: 24rpx;
}
.rv-tag {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex: 0 0 auto;
}
.rv-label {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
  flex: 1 1 auto;
  min-width: 120rpx;
}
.rv-meta {
  font-size: 22rpx;
  color: var(--ink-2);
  flex: 0 0 100%;
  margin-top: -4rpx;
}
.rv-item .btn.mini {
  flex: 0 0 auto;
  margin-left: auto;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-emoji { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; color: var(--ink); font-weight: 600; }
.empty-sub { font-size: 26rpx; color: var(--ink-2); margin-top: 12rpx; }

.foot-space { height: 40rpx; }
