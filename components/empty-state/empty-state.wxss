.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}
.es-emoji { font-size: 80rpx; line-height: 1; margin-bottom: 24rpx; }
.es-spinner {
  width: 64rpx; height: 64rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid var(--ink-3, #cbd5e1);
  border-top-color: var(--c-quiz, #2f8f78);
  border-radius: 50%;
  animation: es-spin .8s linear infinite;
}
@keyframes es-spin { to { transform: rotate(360deg); } }
.es-title { font-size: 32rpx; font-weight: 600; color: var(--ink, #1f2937); }
.es-sub { margin-top: 12rpx; font-size: 26rpx; color: var(--ink-2, #6b7280); line-height: 1.5; }
.es-retry {
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: var(--c-quiz, #2f8f78);
  color: #fff;
  font-size: 28rpx;
}
.es.state-error .es-title { color: var(--ink, #1f2937); }
