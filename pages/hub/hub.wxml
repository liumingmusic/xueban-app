<view class="app-root {{themeClass}} {{fontClass}}">
<view class="page-head ph-poetry fade-in">
  <view class="ph-wm">学</view>
  <view class="ph-block">枢</view>
  <view class="ph-body">
    <view class="ph-title">{{greeting}}</view>
    <view class="ph-chip">{{dateCn}}</view>
  </view>
  <view class="ph-search" bindtap="goSearch" hover-class="press">🔍</view>
</view>

<!-- 今日目标卡 -->
<view class="card goal-card fade-in">
  <view class="goal-top">
    <view class="goal-side">
      <view class="goal-streak">🔥 {{streak}} 天</view>
      <view class="goal-side-sub">连续学习</view>
    </view>
    <view class="goal-divider"></view>
    <view class="goal-side goal-right">
      <view class="goal-count"><text class="goal-num">{{goalDone}}</text>/{{goalTarget}}</view>
      <view class="goal-side-sub">今日学习模块</view>
    </view>
  </view>
  <view class="goal-bar">
    <view class="goal-bar-fill" style="width: {{goalTarget ? (goalDone * 100 / goalTarget) : 0}}%;"></view>
  </view>
  <view class="goal-tip">{{goalDone >= goalTarget ? '今日目标已达成，太棒了 ✓' : '还差 ' + (goalTarget - goalDone) + ' 个，点下方卡片开始吧'}}</view>
</view>

<!-- 个性化模块区：按 hubLayout（顺序 + 显隐）渲染 -->
<view wx:for="{{sections}}" wx:key="key" class="card fade-in" data-go="{{item.key}}" bindtap="goSection" hover-class="press">

  <block wx:if="{{item.key === 'poem'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-poetry);"></view>今日诗词</view>
    <view class="poem-title">{{item.poem.title}}</view>
    <view class="poem-meta">{{item.poem.dynasty}} · {{item.poem.author}}</view>
    <view class="poem-lines">
      <view wx:for="{{item.poem.first}}" wx:for-item="ln" wx:key="index" class="poem-line">{{ln}}</view>
    </view>
    <view class="go-hint">读全篇 ›</view>
    <related-rail tags="{{item.poem.tags}}" exclude="poetry" catchtap="noop" />
  </block>

  <block wx:elif="{{item.key === 'idiom'}}">
    <view class="card-title">
      <view class="dot" style="background: var(--c-idiom);"></view>今日成语
      <text class="state {{item.idiomLearned ? 'ok' : ''}}">{{item.idiomLearned ? '已学 ✓' : '未学'}}</text>
    </view>
    <view class="idiom-word">{{item.idiom.word}}</view>
    <view class="idiom-pinyin">{{item.idiom.pinyin}}</view>
    <view class="idiom-brief">{{item.idiom.brief}}…</view>
    <view class="go-hint">听典故 ›</view>
    <related-rail tags="{{item.idiom.tags}}" exclude="idiom" catchtap="noop" />
  </block>

  <block wx:elif="{{item.key === 'quote'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-quote);"></view>每日一句</view>
    <view class="quote-text">「{{item.quote.text}}」</view>
    <view class="quote-from">—— {{item.quote.from}}{{item.quote.author ? ' · ' + item.quote.author : ''}}</view>
  </block>

  <block wx:elif="{{item.key === 'review'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-quiz);"></view>今日复习</view>
    <view class="quiz-line">有 <text class="quiz-num">{{item.reviewDue}}</text> 个已学内容待复习，巩固记忆不遗忘</view>
    <view class="go-hint">开始复习 ›</view>
  </block>

  <block wx:elif="{{item.key === 'quiz'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-quiz);"></view>闯关挑战</view>
    <view class="quiz-score">
      <view class="qs-cell"><view class="qs-num">{{item.quizPoints}}</view><view class="qs-label">积分</view></view>
      <view class="qs-cell"><view class="qs-num">{{item.quizStreak}}</view><view class="qs-label">连胜</view></view>
      <view class="qs-cell"><view class="qs-num">{{item.quizLevel}}</view><view class="qs-label">段位</view></view>
    </view>
    <view wx:if="{{item.quizWrongCount > 0}}" class="quiz-line">
      错题本还有 <text class="quiz-num">{{item.quizWrongCount}}</text> 道题等你消灭，今天再战一轮？
    </view>
    <view wx:else class="quiz-line">
      题库共 <text class="quiz-num">{{item.quizTotal}}</text> 道题，今天来一组每日挑战吧！
    </view>
    <view class="go-hint">开始闯关 ›</view>
  </block>

  <block wx:elif="{{item.key === 'habit'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-habit);"></view>习惯打卡</view>
    <block wx:if="{{item.habitTotal === 0}}">
      <view class="quiz-line">还没有习惯，添加第一个开始坚持吧</view>
    </block>
    <block wx:else>
      <view class="quiz-line">今日打卡 {{item.habitDone}}/{{item.habitTotal}} · 最长连胜 🔥 {{item.habitStreak}} 天</view>
      <view class="habit-bar">
        <view class="habit-bar-fill" style="width: {{item.habitTotal ? (item.habitDone * 100 / item.habitTotal) : 0}}%;"></view>
      </view>
      <view wx:if="{{item.habitDone < item.habitTotal}}" class="go-hint">还差 {{item.habitTotal - item.habitDone}} 个，去打卡 ›</view>
      <view wx:else class="go-hint">今日已全勤，太棒了 ✓</view>
    </block>
  </block>

  <block wx:elif="{{item.key === 'english'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-english);"></view>每日单词</view>
    <block wx:if="{{item.word}}">
      <view class="word-main">{{item.word.word}}</view>
      <view class="word-sub">{{item.word.cn}}</view>
      <view class="go-hint">学这个词 ›</view>
    </block>
    <block wx:else>
      <skeleton wx:if="{{!item.offline}}" variant="text" rows="2" />
      <view wx:else class="quiz-line">离线中，今日单词稍后加载</view>
    </block>
  </block>

  <block wx:elif="{{item.key === 'history'}}">
    <view class="card-title"><view class="dot" style="background: var(--c-history);"></view>历史上的今天</view>
    <view wx:for="{{item.events}}" wx:for-item="ev" wx:key="year" class="hist-item">
      <text class="hist-year">{{ev.year}}</text>
      <text class="hist-text">{{ev.text}}</text>
    </view>
    <view class="go-hint">看今日全部 ›</view>
  </block>

</view>

<view wx:if="{{sections.length === 0}}" class="card fade-in manage-hint" bindtap="goManage" hover-class="press">
  <view class="quiz-line">首页模块都已隐藏，点此去「管理首页」重新开启</view>
</view>

<view class="foot-space"></view>
</view>
