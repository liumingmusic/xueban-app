.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.press { transform: scale(0.99); transition: transform 0.1s; }

/* 诗词卡 */
.poem-title { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.poem-meta { font-size: 24rpx; color: var(--ink-2); margin: 6rpx 0 16rpx; }
.poem-line { font-size: 32rpx; letter-spacing: 3rpx; line-height: 1.9; }

/* 成语卡 */
.state {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.state.ok { color: #fff; background: var(--c-idiom); border-color: var(--c-idiom); }
.idiom-word { font-size: 48rpx; font-weight: 700; letter-spacing: 8rpx; }
.idiom-pinyin { font-size: 26rpx; color: var(--c-idiom); margin: 4rpx 0 12rpx; }
.idiom-brief { font-size: 28rpx; color: var(--ink-2); }

/* 一句卡 */
.quote-text { font-size: 32rpx; line-height: 1.8; }
.quote-from { font-size: 24rpx; color: var(--ink-2); margin-top: 12rpx; text-align: right; }

/* 闯关卡 */
.quiz-line { font-size: 28rpx; }
.quiz-num { font-size: 36rpx; font-weight: 700; color: var(--c-quiz); padding: 0 4rpx; }

.foot-space { height: 40rpx; }

/* 每日单词卡 */
.word-main { font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; color: var(--ink); }
.word-sub { font-size: 26rpx; color: var(--ink-2); margin-top: 6rpx; line-height: 1.5; }

/* 历史上的今天卡 */
.hist-item { display: flex; gap: 14rpx; align-items: flex-start; padding: 7rpx 0; }
.hist-year { flex: 0 0 auto; font-size: 24rpx; font-weight: 700; color: var(--c-history); font-variant-numeric: tabular-nums; }
.hist-text { flex: 1; font-size: 26rpx; color: var(--ink-2); line-height: 1.5; }

/* 闯关战绩分栏 */
.quiz-score { display: flex; gap: 12rpx; margin: 4rpx 0 12rpx; }
.qs-cell {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 16rpx;
  background: rgba(37, 99, 235, 0.10);
}
.qs-num { font-size: 40rpx; font-weight: 700; color: var(--c-quiz); line-height: 1.2; }
.qs-label { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }

/* 今日目标卡 */
.goal-card { background: linear-gradient(135deg, rgba(47, 143, 120, 0.12) 0%, var(--card) 60%); }
.goal-top { display: flex; align-items: center; }
.goal-side { flex: 1; text-align: center; }
.goal-divider { width: 1rpx; height: 56rpx; background: var(--line); }
.goal-streak { font-size: 38rpx; font-weight: 700; color: var(--c-history); }
.goal-count { font-size: 38rpx; font-weight: 700; color: var(--c-poetry); }
.goal-num { font-size: 48rpx; }
.goal-side-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }
.goal-bar {
  height: 16rpx; background: var(--bg); border-radius: 999rpx; overflow: hidden;
  margin: 18rpx 0 10rpx;
}
.goal-bar-fill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, var(--c-poetry), var(--c-english));
  transition: width 0.5s ease;
}
.goal-tip { font-size: 24rpx; color: var(--ink-2); text-align: center; }
