.bar-row { display: flex; align-items: center; margin: 18rpx 0; }
.bar-label { width: 150rpx; font-size: 26rpx; color: var(--ink-2); flex-shrink: 0; }
.bar-track { flex: 1; height: 24rpx; background: var(--bg); border-radius: 999rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; min-width: 8rpx; transition: width 0.4s ease; }
.bar-num { width: 80rpx; text-align: right; font-size: 28rpx; font-weight: 700; }

.wrong-grid { display: flex; }
.wrong-cell { flex: 1; text-align: center; padding: 12rpx 0; }
.wrong-num { font-size: 56rpx; font-weight: 700; line-height: 1.3; }
.wrong-label { font-size: 24rpx; color: var(--ink-2); }
.press { opacity: 0.7; }

.heat { display: flex; gap: 8rpx; justify-content: space-between; }
.heat-col { display: flex; flex-direction: column; gap: 8rpx; }
.heat-cell {
  width: 40rpx; height: 40rpx; border-radius: 8rpx;
  background: #f1ece2;
}
.heat-cell.lv1 { background: #bfe3d5; }
.heat-cell.lv2 { background: #6db99f; }
.heat-cell.lv3 { background: #2f8f78; }
.heat-cell.future { opacity: 0; }
.heat-legend {
  display: flex; align-items: center; gap: 10rpx;
  justify-content: flex-end; margin-top: 20rpx;
  font-size: 22rpx; color: var(--ink-2);
}
.heat-legend .heat-cell { width: 28rpx; height: 28rpx; }
.foot-space { height: 40rpx; }

/* 闯关战绩分栏（与中枢复用同名类） */
.quiz-score { display: flex; gap: 12rpx; margin: 4rpx 0 12rpx; }
.qs-cell {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 16rpx;
  background: rgba(37, 99, 235, 0.10);
}
.qs-num { font-size: 40rpx; font-weight: 700; color: #2563eb; line-height: 1.2; }
.qs-label { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }

/* 空状态 */
.empty-state { text-align: center; padding: 56rpx 24rpx; }
.empty-emoji { font-size: 72rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; margin-top: 12rpx; }
.empty-sub { font-size: 26rpx; color: var(--ink-2); margin-top: 8rpx; }
