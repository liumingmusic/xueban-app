<view class="app-root {{themeClass}} {{fontClass}}">
<view class="page-head ph-quiz fade-in">
  <view class="ph-wm">长</view>
  <view class="ph-block">长</view>
  <view class="ph-body">
    <view class="ph-title">我的成长</view>
    <view class="ph-chip">建档于 {{createdAt}}</view>
  </view>
</view>

<!-- 空状态：首用引导 -->
<view wx:if="{{isEmpty}}" class="card empty-state fade-in">
  <view class="empty-emoji">🌱</view>
  <view class="empty-title">还没有学习记录</view>
  <view class="empty-sub">去「中枢」翻开今天的第一首诗吧</view>
</view>

<!-- 闯关战绩 -->
<view class="card fade-in">
  <view class="card-title"><view class="dot" style="background: var(--c-quiz);"></view>闯关战绩</view>
  <view class="quiz-score">
    <view class="qs-cell"><view class="qs-num">{{quizPoints}}</view><view class="qs-label">积分</view></view>
    <view class="qs-cell"><view class="qs-num">{{quizStreak}}</view><view class="qs-label">连胜</view></view>
    <view class="qs-cell"><view class="qs-num">{{quizLevel}}</view><view class="qs-label">段位</view></view>
  </view>
  <view class="go-hint" bindtap="goQuiz" hover-class="press">去闯关 ›</view>
</view>

<!-- 掌握量 -->
<view class="card fade-in">
  <view class="card-title"><view class="dot" style="background: var(--c-poetry);"></view>掌握量</view>
  <view wx:for="{{counts}}" wx:key="label" class="bar-row">
    <text class="bar-label">{{item.label}}</text>
    <view class="bar-track">
      <view class="bar-fill" style="width: {{item.pct}}%; background: {{item.color}};"></view>
    </view>
    <text class="bar-num">{{item.num}}</text>
  </view>
</view>

<!-- 成就里程碑 -->
<view class="card fade-in">
  <view class="card-title"><view class="dot" style="background: var(--c-habit);"></view>成就里程碑</view>
  <view class="ach-grid">
    <view wx:for="{{achievements}}" wx:key="key" class="ach-cell {{item.unlocked ? 'on' : ''}}">
      <view class="ach-emoji">{{item.emoji}}</view>
      <view class="ach-name">{{item.title}}</view>
      <view class="ach-desc">{{item.desc}}</view>
      <view wx:if="{{item.unlocked}}" class="ach-badge">✓</view>
    </view>
  </view>
</view>

<!-- 待消灭 -->
<view class="card fade-in">
  <view class="card-title"><view class="dot" style="background: var(--c-quiz);"></view>待消灭</view>
  <view class="wrong-grid">
    <view class="wrong-cell" bindtap="goQuiz" hover-class="press">
      <view class="wrong-num" style="color: {{wrongs[0].color}};">{{wrongs[0].num}}</view>
      <view class="wrong-label">{{wrongs[0].label}} ›</view>
    </view>
    <view class="wrong-cell" bindtap="goEnglish" hover-class="press">
      <view class="wrong-num" style="color: {{wrongs[1].color}};">{{wrongs[1].num}}</view>
      <view class="wrong-label">{{wrongs[1].label}} ›</view>
    </view>
    <view class="wrong-cell" bindtap="goReview" hover-class="press">
      <view class="wrong-num" style="color: #3a78a8;">{{reviewDue}}</view>
      <view class="wrong-label">今日待复习 ›</view>
    </view>
  </view>
</view>

<!-- 活跃热力（近 12 周） -->
<view class="card fade-in">
  <view class="card-title"><view class="dot" style="background: var(--c-history);"></view>学习热力 · 近 12 周</view>
  <view class="heat">
    <view wx:for="{{heatWeeks}}" wx:key="index" wx:for-item="week" class="heat-col">
      <view wx:for="{{week}}" wx:key="key" wx:for-item="day"
            class="heat-cell lv{{day.lv}} {{day.future ? 'future' : ''}}"></view>
    </view>
  </view>
  <view class="heat-legend">
    <text>少</text>
    <view class="heat-cell lv0"></view>
    <view class="heat-cell lv1"></view>
    <view class="heat-cell lv2"></view>
    <view class="heat-cell lv3"></view>
    <text>多</text>
  </view>
</view>

<view class="foot-space"></view>
</view>
