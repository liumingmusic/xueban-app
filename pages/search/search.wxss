.search-page { padding: 0 0 40rpx; min-height: 100vh; background: var(--bg); }

/* 吸顶搜索头 */
.search-head {
  position: sticky; top: 0; z-index: 10;
  background: var(--bg);
  padding: 18rpx 24rpx 14rpx;
  box-shadow: 0 6rpx 16rpx rgba(60,45,20,0.05);
}
.search-bar {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: 999rpx; padding: 0 26rpx; height: 82rpx; box-sizing: border-box;
  box-shadow: inset 0 1rpx 4rpx rgba(60,45,20,0.04);
}
.search-ico { font-size: 30rpx; opacity: 0.55; }
.search-field { flex: 1; height: 82rpx; line-height: 82rpx; font-size: 28rpx; color: var(--ink); }
.search-clear {
  font-size: 24rpx; color: #fff; background: var(--ink-3);
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%;
}

/* 分段筛选（选中态用各模块自身主题色） */
.seg {
  display: flex; gap: 14rpx; padding: 22rpx 24rpx 6rpx;
  white-space: nowrap; overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.seg-item {
  flex: 0 0 auto; padding: 12rpx 30rpx; font-size: 26rpx; color: var(--ink-2);
  background: var(--card); border: 1rpx solid var(--line); border-radius: 999rpx; white-space: nowrap;
}
.seg-item.on { color: #fff; font-weight: 600; }

/* 示例词卡 */
.tip-card {
  margin: 18rpx 24rpx; background: var(--card); border-radius: var(--radius);
  padding: 28rpx 28rpx 24rpx; box-shadow: 0 4rpx 20rpx rgba(60,45,20,0.06);
}
.tip-title { font-size: 28rpx; font-weight: 600; color: var(--ink); margin-bottom: 18rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  font-size: 26rpx; color: var(--c-quote);
  background: rgba(58,120,168,0.08); border: 1rpx solid rgba(58,120,168,0.18);
  border-radius: 999rpx; padding: 10rpx 26rpx;
}
.tip-rule { margin-top: 18rpx; font-size: 23rpx; color: #b8860b; }

.result-meta { padding: 14rpx 24rpx 4rpx; font-size: 24rpx; color: var(--ink-3); }

/* 分组 */
.group { margin: 10rpx 24rpx 18rpx; }
.group-title {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 26rpx; font-weight: 600; color: var(--ink-2);
  padding: 14rpx 4rpx 10rpx;
}
.dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; }

/* 结果行：左侧模块色条 + 卡片化 */
.result-row {
  position: relative; display: flex; align-items: center; gap: 16rpx;
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: 18rpx; padding: 22rpx 22rpx 22rpx 30rpx; margin-bottom: 14rpx; overflow: hidden;
}
.result-row::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx;
  background: var(--accent, var(--c-poetry));
}
.result-main { flex: 1; min-width: 0; }
.result-title { font-size: 30rpx; color: var(--ink); font-weight: 600; }
.result-extra {
  margin-top: 6rpx; font-size: 24rpx; color: var(--ink-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.result-sub {
  flex: 0 0 auto; font-size: 22rpx; color: var(--ink-2);
  background: var(--bg); border-radius: 8rpx; padding: 4rpx 12rpx; max-width: 200rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.result-arrow { flex: 0 0 auto; font-size: 36rpx; color: var(--ink-3); }

/* 空态 */
.empty { text-align: center; padding: 120rpx 40rpx; }
.empty-emoji { font-size: 80rpx; }
.empty-text { margin-top: 20rpx; font-size: 30rpx; color: var(--ink-2); }
.empty-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-3); }

/* 暗色模式下示例 chip 用更明显的底 */
.app-root.dark .chip { color: var(--c-quote); background: rgba(58,120,168,0.18); border-color: rgba(58,120,168,0.32); }
