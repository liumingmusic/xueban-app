/* 新手引导 */
.guide {
  height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.skip {
  align-self: flex-end;
  margin-top: 40rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}
.swiper {
  width: 100%;
  flex: 1 1 auto;
  min-height: 480rpx; /* 兜底：防止 flex 高度塌缩时整片空白 */
}
.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 20rpx;
}
.emoji { font-size: 140rpx; margin-bottom: 48rpx; }
.title { font-size: 44rpx; font-weight: 700; color: var(--ink); margin-bottom: 28rpx; }
.desc { font-size: 30rpx; color: var(--ink-2); line-height: 1.7; max-width: 520rpx; }

.dots { display: flex; gap: 16rpx; margin-bottom: 40rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; background: var(--line); transition: all .2s; }
.dot.on { width: 36rpx; background: var(--c-poetry); }

.next {
  width: 100%;
  margin-bottom: 60rpx;
  background: var(--c-poetry);
  color: #fff;
}
