/* 分组标题 */
.group { padding: 0 24rpx; }
.group-title {
  font-size: 26rpx;
  color: var(--ink-2);
  letter-spacing: 4rpx;
  margin: 24rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
}
.group-title .dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  margin-right: 12rpx;
}
.group-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--bg);
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
}

/* 收藏条目 */
.fav-item {
  display: flex;
  align-items: stretch;
  padding: 0;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.fav-bar {
  width: 8rpx;
  flex: 0 0 auto;
}
.fav-body {
  flex: 1;
  padding: 24rpx 24rpx;
  min-width: 0;
}
.fav-title {
  font-size: 30rpx;
  color: var(--ink-1);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.fav-sub {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fav-arrow {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: 40rpx;
  color: var(--ink-3);
}

/* 空状态（复用全局风格） */
.empty-state { text-align: center; padding: 80rpx 40rpx; }
.empty-emoji { font-size: 80rpx; }
.empty-title { font-size: 32rpx; color: var(--ink-1); margin-top: 16rpx; }
.empty-sub { font-size: 26rpx; color: var(--ink-2); margin-top: 10rpx; line-height: 1.6; }

.foot-space { height: 40rpx; }
