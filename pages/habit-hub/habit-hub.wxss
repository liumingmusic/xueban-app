.center-card { text-align: center; }
.big-num { font-size: 96rpx; font-weight: 700; color: var(--c-poetry); line-height: 1.2; }
.big-label { font-size: 26rpx; color: var(--ink-2); letter-spacing: 4rpx; }
.last { font-size: 22rpx; color: var(--ink-2); margin-top: 12rpx; }

.mod-row {
  display: flex; align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
  min-height: 88rpx;
}
.mod-row:last-child { border-bottom: none; }
.mod-icon { font-size: 44rpx; margin-right: 20rpx; }
.mod-body { flex: 1; }
.mod-name { font-size: 30rpx; font-weight: 600; }
.mod-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 2rpx; }
.mod-streak { font-size: 30rpx; font-weight: 700; color: #b45309; }

.entry { position: relative; }
.entry-text { font-size: 26rpx; color: var(--ink-2); padding-right: 40rpx; }
.entry-arrow { position: absolute; right: 32rpx; top: 50%; transform: translateY(-50%); font-size: 44rpx; color: var(--ink-2); }
.card-tip { font-size: 23rpx; color: var(--ink-3); margin: -6rpx 0 14rpx; line-height: 1.6; }
.add-custom {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx; color: var(--c-poetry);
  padding: 18rpx 0;
  border: 2rpx dashed var(--c-poetry);
  border-radius: 16rpx;
}
.add-custom:active { background: var(--ph-tint, rgba(47,143,120,.10)); }
.app-root.dark .add-custom { border-color: #5FB89B; color: #8fd4bd; }
.app-root.dark .add-custom:active { background: rgba(95,184,155,.16); }

.foot-space { height: 40rpx; }
